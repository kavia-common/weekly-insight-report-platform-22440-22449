# Frontend environment variables (Create React App)
# Copy this file to .env and fill in the values.

# Base URLs for your backend (optional)
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=http://localhost:3000

# Feature flags (comma-separated, optional)
REACT_APP_FEATURE_FLAGS=

# Supabase configuration
# Use the React-safe variables below. These will be used by the frontend to initialize Supabase.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# If your CI provides non-React env names, these are mirrored as a convenience.
# They are NOT required but supported:
SUPABASE_URL=
SUPABASE_KEY=
